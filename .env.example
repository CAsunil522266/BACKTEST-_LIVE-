# Copy to .env for LOCAL testing only. On a host (Render etc.) enter these in the dashboard's Environment page instead.
# NEVER commit real values. NEVER paste them in chat, email or the HTML.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
# Optional: a shared code for friends. If set, every API call needs it (page asks once).
ACCESS_CODE=
# Optional limits
AI_DAILY_CAP=300
AI_PER_IP_HOUR=20
DATA_DAILY_CAP=4000
DATA_PER_IP_MIN=20
# Set to 1 when hosted behind a proxy (Render/Railway/Nginx) so per-IP limits see the real visitor IP
TRUST_PROXY=1
# Optional: lock to your domain, e.g. backtestlab.onrender.com
ALLOWED_HOSTS=
